{
  "name": "Orrery",
  "version": "0.2.2",
  "description": "Asteroid discovery visualization",
  "main": "src/js/index.js",
  "repository": "git@github.com:sn3p/Orrery.git",
  "author": "Matthijs Kuiper <info@matthijskuiper.nl>",
  "license": "MIT",
  "scripts": {
    "setup": "cd data && ./download_data.sh && ./data_to_json.py",
    "build": "webpack --mode production",
    "test": "npm run build && node tests/build.cjs && node tests/assets.cjs && node --test tests/orbits.test.mjs tests/cpu-orbits.test.mjs tests/orbit-tracks.test.mjs tests/orbit-cache.test.mjs && node tests/gpu.cjs && node tests/scheduling.cjs && node tests/rendering.cjs && node tests/ui.cjs && node tests/benchmark.cjs && node tests/benchmark-clone.cjs && node tests/hmr.cjs",
    "deploy": "gh workflow run pages.yml --ref master",
    "watch": "webpack --mode development --watch",
    "serve": "webpack serve --mode development --open",
    "benchmark": "node benchmarks/run.cjs"
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "cssnano": "^9.0.4",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "1.63.0",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.2",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
