{
  "name": "Orrery",
  "version": "0.2.2",
  "description": "Asteroid discovery visualization",
  "main": "src/js/index.js",
  "repository": "git@github.com:sn3p/Orrery.git",
  "author": "Matthijs Kuiper <info@matthijskuiper.nl>",
  "license": "MIT",
  "scripts": {
    "setup": "cd data && ./download_data.sh && ./data_to_json.py",
    "build": "node scripts/build.cjs",
    "build:next": "node scripts/build.cjs --preview",
    "serve:next": "webpack serve --config webpack.app.config.cjs --mode development",
    "test": "npm run build && npm run test:build && npm run test:node && npm run test:browser",
    "deploy": "gh workflow run pages.yml --ref master",
    "watch": "webpack --config webpack.app.config.cjs --mode development --watch",
    "serve": "webpack serve --config webpack.app.config.cjs --mode development --open",
    "benchmark": "node benchmarks/run.cjs",
    "test:build": "node tests/build.cjs && node tests/next-build.cjs",
    "test:node": "node --test tests/orbits.test.mjs tests/preparation.test.mjs tests/cpu-orbits.test.mjs tests/orbit-tracks.test.mjs tests/orbit-cache.test.mjs tests/catalog-source.cjs tests/catalog-latest.cjs tests/catalog-delivery.cjs tests/catalog-manifest.cjs tests/catalogue-model.test.mjs tests/catalog-benchmark-inputs.cjs tests/harness.test.cjs",
    "test:browser": "playwright test",
    "test:unified": "npm run build:next && playwright test --config playwright.standalone.config.cjs",
    "benchmark:next": "ORRERY_TEST_APP=unified node benchmarks/run.cjs",
    "catalog:build": "node scripts/catalog.cjs build",
    "test:catalog": "playwright test catalog.spec.cjs catalog-chromium.spec.cjs",
    "benchmark:catalog": "node benchmarks/catalog-loading.cjs",
    "test:fixtures": "node tests/fixture-builds.cjs"
  },
  "dependencies": {
    "dat.gui": "^0.7.9",
    "pixi.js": "^8.20.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@playwright/test": "1.63.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "cssnano": "^9.0.4",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "1.63.0",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.2",
    "tar": "^7.5.22",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
